# ── Takeover Hunter configuration ─────────────────────────────────────────
# Copy to `.env` and adjust. All values are optional; defaults shown.

# Server
HOST=0.0.0.0
PORT=5000
DEBUG=0

# Authentication — if set, every /api/* call must present this token via
# `X-API-Key: <token>` or `Authorization: Bearer <token>`. Leave empty for an
# open (local/trusted-network only) deployment.
API_KEY=

# Rate limiting (per client IP, sliding window)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# SSRF guard — when 0 (default), targets resolving to private/reserved IP
# space are refused before any HTTP probe. Set 1 ONLY for isolated lab use.
ALLOW_PRIVATE_TARGETS=0

# Workload caps
MAX_SUBDOMAINS=5000
MAX_BULK_URLS=2000
MAX_SCAN_WORKERS=30
MAX_JS_FILES=50

# Network timeouts (seconds)
DNS_TIMEOUT=2
DNS_LIFETIME=4
HTTP_TIMEOUT=4
TOOL_TIMEOUT=180
HTTP_BODY_CAP=2000

# DNS resolvers (comma-separated)
DNS_RESOLVERS=8.8.8.8,1.1.1.1

# Probe identity
BUG_BOUNTY_HEADER=takeover-hunter
USER_AGENT=Mozilla/5.0 (compatible; TakeoverHunter/2.0)

# gunicorn (production)
WEB_CONCURRENCY=4
WEB_THREADS=8
WEB_TIMEOUT=300
