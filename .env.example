# ==============================================================================
# Takeover Hunter v2.0.0 — Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
FLASK_ENV=production
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex

# Access Control & Security
# If set, all /api/* requests must supply Header: X-API-Key: <key> or Bearer token
TAKEOVER_API_KEY=
RATE_LIMIT_PER_MINUTE=60

# Workload Caps & Execution Limits
MAX_SUBDOMAINS_PER_SCAN=500
MAX_CONCURRENT_WORKERS=20
HTTP_TIMEOUT_SECONDS=4
DNS_TIMEOUT_SECONDS=3

# SMTP Alerting (Optional)
# Used for automated takeover notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=
SMTP_USE_TLS=true
ALERT_EMAIL=security-team@example.com

# Target Platforms for Reporting
DEFAULT_REPORTER_USER=security-researcher
DEFAULT_PLATFORM=HackerOne
